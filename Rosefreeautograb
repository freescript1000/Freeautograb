-- FUNCIONES PRINCIPALES OPTIMIZADAS
-- ============================================================
local function getStealHRP()
	local c = LP.Character
	if not c then return nil end
	return c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("UpperTorso")
end

local function isMyPlotByName(plotName)
	local plots = workspace:FindFirstChild("Plots")
	if not plots then return false end
	local plot = plots:FindFirstChild(plotName)
	if not plot then return false end
	local sign = plot:FindFirstChild("PlotSign")
	if not sign then return false end
	local yb = sign:FindFirstChild("YourBase")
	return yb and yb:IsA("BillboardGui") and yb.Enabled
end

local function getPromptPosition(prompt)
	if not prompt then return nil end
	local p = prompt.Parent
	while p and p ~= workspace do
		if p:IsA("BasePart") then return p.Position end
		p = p.Parent
	end
	return nil
end

-- Cache para búsquedas de prompts
local promptCache = {}
local cacheTime = 0

local function findNearestPrompt()
	local hrp = getStealHRP()
	if not hrp then return nil end
	
	local now = tick()
	if now - cacheTime < 0.5 then
		if promptCache.prompt and promptCache.prompt.Parent then
			local pos = getPromptPosition(promptCache.prompt)
			if pos then
				local d = (pos - hrp.Position).Magnitude
				if d <= Steal.StealRadius then
					return promptCache.prompt
				end
			end
		end
	end
	cacheTime = now
	
	local nearest, dist = nil, math.huge
	local plots = workspace:FindFirstChild("Plots")
	
	if plots then
		for _, plot in ipairs(plots:GetChildren()) do
			if isMyPlotByName(plot.Name) then continue end
			local pods = plot:FindFirstChild("AnimalPodiums")
			if not pods then continue end
			for _, pod in ipairs(pods:GetChildren()) do
				local base = pod:FindFirstChild("Base")
				if not base then continue end
				local spawn = base:FindFirstChild("Spawn")
				if not spawn then continue end
				local d = (spawn.Position - hrp.Position).Magnitude
				if d <= Steal.StealRadius and d < dist then
					local att = spawn:FindFirstChild("PromptAttachment")
					if att then
						for _, p in ipairs(att:GetChildren()) do
							if p:IsA("ProximityPrompt") and p.ActionText then
								local text = p.ActionText:lower()
								if text:find("steal") or text:find("robar") or text:find("take") then
									nearest, dist = p, d
								end
							end
						end
					end
				end
			end
		end
	end
	
	if not nearest then
		if math.random(1, 3) == 1 then
			for _, prompt in ipairs(workspace:GetDescendants()) do
				if prompt:IsA("ProximityPrompt") and prompt.ActionText then
					local text = prompt.ActionText:lower()
					if text:find("steal") or text:find("robar") or text:find("take") or text:find("brainrot") then
						local pos = getPromptPosition(prompt)
						if pos then
							local d = (pos - hrp.Position).Magnitude
							if d <= Steal.StealRadius and d < dist then
								nearest, dist = prompt, d
							end
						end
					end
				end
			end
		end
	end
	
	if nearest then
		promptCache.prompt = nearest
	else
		promptCache.prompt = nil
	end
	
	return nearest
end

local function setBar(p)
	p = math.clamp(p or 0, 0, 1)
	if progressFill then 
		progressFill.Size = UDim2.new(p, 0, 1, 0)
	end
	local pct = math.floor(p * 100)
	if title then
		title.Text = string.format("%d%% | ROSE Auto Steal", pct)
	end
end

-- ============================================================
-- EXECUTE STEAL
-- ============================================================
local function executeSteal(prompt)
	if isStealing or not Steal.AutoStealEnabled then return end
	if not prompt then return end
	
	if not Steal.Data[prompt] then
		Steal.Data[prompt] = { hold = {}, trigger = {}, ready = true }
		if getconnections then
			for _, c in ipairs(getconnections(prompt.PromptButtonHoldBegan) or {}) do
				if c.Function then table.insert(Steal.Data[prompt].hold, c.Function) end
			end
			for _, c in ipairs(getconnections(prompt.Triggered) or {}) do
				if c.Function then table.insert(Steal.Data[prompt].trigger, c.Function) end
			end
		end
	end
	
	local data = Steal.Data[prompt]
	if not data.ready then return end
	data.ready = false
	isStealing = true
	
	task.spawn(function()
		for _, f in ipairs(data.hold) do pcall(f) end
	end)
	
	local cfg = STEAL_MODE_CFG[Steal.Mode] or STEAL_MODE_CFG[4]
	local threshold = cfg.threshold
	local nearDist = cfg.nearDist
	local totalTime = tonumber(Steal.StealDuration) or 1.3
	local timeToThreshold = totalTime * threshold
	local timeAfterThreshold = totalTime - timeToThreshold
	local startTime = tick()
	
	while tick() - startTime < timeToThreshold do
		if not Steal.AutoStealEnabled then
			isStealing = false; data.ready = true; setBar(0); return
		end
		setBar(math.clamp((tick() - startTime) / totalTime, 0, threshold))
		task.wait()
	end
	setBar(threshold)
	
	local stillNear = false
	local hrp = getStealHRP()
	if hrp then
		local targetPos = getPromptPosition(prompt)
		if targetPos and (targetPos - hrp.Position).Magnitude <= nearDist then
			stillNear = true
		end
	end
	
	if not stillNear then
		local holdStart = tick()
		while tick() - holdStart < 4 do
			if not Steal.AutoStealEnabled then
				isStealing = false; data.ready = true; setBar(0); return
			end
			setBar(threshold)
			local hrp2 = getStealHRP()
			if hrp2 then
				local tp = getPromptPosition(prompt)
				if tp and (tp - hrp2.Position).Magnitude <= nearDist then
					stillNear = true
					break
				end
			end
			task.wait()
		end
		if not stillNear then
			isStealing = false; data.ready = true; setBar(0); return
		end
	end
	
	local resumeTime = tick()
	while tick() - resumeTime < timeAfterThreshold do
		if not Steal.AutoStealEnabled then
			isStealing = false; data.ready = true; setBar(0); return
		end
		local fin = (tick() - resumeTime) / math.max(timeAfterThreshold, 0.01)
		setBar(threshold + fin * (1 - threshold))
		task.wait()
	end
	setBar(1)
	
	for _, f in ipairs(data.trigger) do pcall(f) end
	
	if #data.trigger == 0 then
		pcall(function()
			if fireproximityprompt then
				fireproximityprompt(prompt, 1)
			elseif prompt:FindFirstChild("Activate") then
				prompt.Activate:Fire()
			else
				for _, v in ipairs(prompt:GetChildren()) do
					if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
						v:FireServer()
					end
				end
			end
		end)
	end
	
	task.wait(0.05)
	data.ready = true
	isStealing = false
	setBar(0)
end

local function startAutoSteal()
	if stealConn then 
		stealConn:Disconnect()
	end
	
	local scanCounter = 0
	stealConn = RunService.Heartbeat:Connect(function()
		if isStealing or not Steal.AutoStealEnabled then return end
		
		scanCounter = scanCounter + 1
		if scanCounter % 2 ~= 0 then return end
		
		local ok, prompt = pcall(findNearestPrompt)
		if ok and prompt then
			pcall(executeSteal, prompt)
		end
	end)
	print("AutoSteal iniciado - Rose")
end

